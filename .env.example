
# ---------- API ----------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# ---------- Screenshots ----------
# Absolute path to the folder where your screenshots are saved. REQUIRED.
# Linux example:   /home/you/Pictures/Screenshots
# macOS example:   /Users/you/Desktop
# Windows example: C:/Users/you/Pictures/Screenshots
SCREENSHOT_DIR= 
SCAN_RECURSIVE=false
# Watch the folder and index new screenshots as they appear
WATCH_ENABLED=true
# Index existing screenshots in the background when the server starts
BACKFILL_ON_START=true
SUPPORTED_EXTENSIONS=png,jpg,jpeg,webp

# ---------- Storage ----------
# SQLite database and thumbnails live here
DATA_DIR=./data
THUMBNAIL_SIZE=360

# ---------- Model provider ----------
# gemini  = hosted Gemma + embeddings through the Gemini API (light on your laptop)
# ollama  = fully local models (private, needs a capable machine)
LLM_PROVIDER=gemini

# ---------- Gemini API (LLM_PROVIDER=gemini) ----------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REQUEST_TIMEOUT_SECONDS=120

# ---------- Ollama (LLM_PROVIDER=ollama) ----------
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Models ----------
# Confirm exact IDs in AI Studio before running.
# gemini example: VISION_MODEL=gemma-4-26b-a4b-it   EMBEDDING_MODEL=gemini-embedding-001
# ollama example: VISION_MODEL=gemma3:4b             EMBEDDING_MODEL=embeddinggemma
VISION_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector size you request from EMBEDDING_MODEL.
# If you change this, delete DATA_DIR/snaprecall.db and re-index.
EMBEDDING_DIM=768
# Longest image side (px) sent to the vision model. Lower = faster and cheaper.
MAX_IMAGE_SIDE=1024

# ---------- OCR ----------
# tesseract | none  (none is recommended in hosted mode, Gemma reads the text)
OCR_ENGINE=none
OCR_LANGS=eng+hin
# Only needed if tesseract is not on PATH (common on Windows)
TESSERACT_CMD=

# ---------- Background worker (slow and steady) ----------
# Pause between images. Higher is safer on free API tiers.
WORKER_THROTTLE_SECONDS=6
WORKER_MAX_RETRIES=3
# Stop sending requests after this many API calls per day. 0 = no limit.
DAILY_REQUEST_BUDGET=0

# ---------- Search ----------
SEARCH_DEFAULT_LIMIT=24
# Candidates pulled from each of keyword and semantic search before fusion
SEARCH_CANDIDATES=50
# Reciprocal Rank Fusion constant
RRF_K=60